{
  "name": "dsh-video-prompt",
  "version": "0.10.0",
  "description": "DSH Desktop 创作助手：整理图片、视频与文本素材，准备文案、素材抓取、爆款分析、生图与视频提示词任务。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "prompt",
    "image",
    "video-prompt-pipeline"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "skills",
    "cordis.patch.yml",
    "README.md",
    "docs",
    "CHANGELOG.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": ">=0.1.2-alpha.1 <0.3.0",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raylen-berry/dsh-video-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/Raylen-berry/dsh-video-prompt/issues"
  },
  "homepage": "https://github.com/Raylen-berry/dsh-video-prompt#readme",
  "license": "MIT"
}
