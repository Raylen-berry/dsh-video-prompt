{
  "name": "dsh-video-prompt",
  "version": "0.10.0",
  "description": "视频/图片提示词流水线：对话框旁的图片、视频提示词模式入口，素材（图片/视频）与产物（图/视频）两两交互共四条路径（图生图 · 图生视频 · 视频生图 · 视频生视频），角色链 A→B→C→D→E 可选（执行 AI + 生图引擎），另有「生文案」与「扒素材」两个抓取派发栏目（竞品在投素材 / 书免费章节，执行都交给 agent），并注册 video-prompt-pipeline / image-prompt-director 等 7 个技能包。",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "video",
    "prompt",
    "image",
    "video-prompt-pipeline"
  ],
  "type": "module",
  "main": "index.js",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json"
  },
  "scripts": {
    "test": "node tools/run-all.mjs"
  },
  "devDependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "index.js",
    "client.js",
    "skills",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-host-webserver": "^0.1.2-alpha.1",
    "react": "^18.2.0"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Raylen-berry/dsh-video-prompt.git"
  },
  "bugs": {
    "url": "https://github.com/Raylen-berry/dsh-video-prompt/issues"
  },
  "homepage": "https://github.com/Raylen-berry/dsh-video-prompt#readme",
  "license": "MIT"
}
